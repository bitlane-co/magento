<!--
The sync's indexers (docs/magento-plan.md MG9), always "Update by Schedule" (mview.xml; the data patch and the daily
check set it): "Update on Save" has no triggers, so it would see nothing.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Indexer/etc/indexer.xsd">
    <indexer id="bitlane_products" view_id="bitlane_products" class="Bitlane\Search\Model\Indexer\Products">
        <title translate="true">Bitlane products</title>
        <description translate="true">Sends changed products to Bitlane</description>
    </indexer>
    <indexer id="bitlane_categories" view_id="bitlane_categories" class="Bitlane\Search\Model\Indexer\Categories">
        <title translate="true">Bitlane categories</title>
        <description translate="true">Sends changed categories and their products to Bitlane</description>
    </indexer>
    <indexer id="bitlane_options" view_id="bitlane_options" class="Bitlane\Search\Model\Indexer\Options">
        <title translate="true">Bitlane attribute options</title>
        <description translate="true">Sends the products of renamed attribute options to Bitlane</description>
    </indexer>
    <indexer id="bitlane_cms_pages" view_id="bitlane_cms_pages" class="Bitlane\Search\Model\Indexer\CmsPages">
        <title translate="true">Bitlane CMS pages</title>
        <description translate="true">Sends changed CMS pages to Bitlane</description>
    </indexer>
</config>
