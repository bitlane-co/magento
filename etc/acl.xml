<!-- Roles decide who sees the Bitlane screen and who changes it (docs/magento-plan.md MG14). -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Bitlane_Search::view" title="Bitlane" translate="title" sortOrder="55">
                    <resource id="Bitlane_Search::manage" title="Connect and set up" translate="title" sortOrder="10"/>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
