<!--
The events Bitlane counts (docs/magento-plan.md MG17), in every area: the storefront, REST and GraphQL add to carts,
payment callbacks and the admin invoice and refund. And orders and refunds, whose stock the indexers don't see (MG11).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_quote_product_add_after">
        <observer name="bitlane_quote_product_added" instance="Bitlane\Search\Observer\QuoteProductAdded"/>
    </event>
    <event name="sales_quote_save_after">
        <observer name="bitlane_quote_saved" instance="Bitlane\Search\Observer\QuoteSaved"/>
    </event>
    <event name="sales_order_invoice_pay">
        <observer name="bitlane_invoice_paid" instance="Bitlane\Search\Observer\InvoicePaid"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="bitlane_creditmemo_saved" instance="Bitlane\Search\Observer\CreditmemoSaved"/>
    </event>
    <event name="sales_model_service_quote_submit_success">
        <observer name="bitlane_order_placed" instance="Bitlane\Search\Observer\OrderPlaced"/>
    </event>
</config>
