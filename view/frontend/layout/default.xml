<!-- The search widget in every storefront page's head (docs/magento-plan.md MG15); Luma and Hyvä alike. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="head.additional">
            <block class="Magento\Framework\View\Element\Template" name="bitlane.snippet"
                   template="Bitlane_Search::snippet.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Bitlane\Search\ViewModel\Snippet</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
