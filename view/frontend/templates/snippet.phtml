/**
 * The search widget (ViewModel/Snippet.php). Through the secure renderer, so
 * Magento's content security policy allows the inline script.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */

/** @var \Bitlane\Search\ViewModel\Snippet $viewModel */
$viewModel = $block->getData('view_model');
$snippet = $viewModel->snippet();
if ($snippet === null) {
    return;
}
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $snippet['script'], false) ?>
<?= /* @noEscape */ $secureRenderer->renderTag(
    'script',
    ['type' => 'module', 'src' => $snippet['loader_url']],
    ' ',
    false
) ?>
