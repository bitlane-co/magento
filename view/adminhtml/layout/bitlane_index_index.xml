<!-- The Bitlane screen: the React app (admin/, built into web/js and web/css) and its mount point. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Bitlane_Search::css/admin.css"/>
        <script src="Bitlane_Search::js/admin.js" defer="defer"/>
    </head>
    <body>
        <referenceBlock name="page.title" template="Bitlane_Search::title.phtml"/>
        <referenceContainer name="content">
            <block class="Magento\Backend\Block\Template" name="bitlane.screen" template="Bitlane_Search::app.phtml">
                <arguments>
                    <argument name="screen" xsi:type="object">Bitlane\Search\ViewModel\Screen</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
