/**
 * The Bitlane screen's page title: Bitlane's logo where Magento_Theme::title.phtml prints the text.
 *
 * @var \Magento\Theme\Block\Html\Title $block
 * @var \Magento\Framework\Escaper $escaper
 */
$logo = $block->getViewFileUrl('Bitlane_Search::images/logo.svg');
?>
<div class="page-title-wrapper">
    <h1 class="page-title">
        <img class="bitlane-title-logo" src="<?= $escaper->escapeUrl($logo) ?>"
             alt="<?= $escaper->escapeHtmlAttr($block->getPageTitle()) ?>"/>
    </h1>
    <?= $block->getChildHtml() ?>
</div>
